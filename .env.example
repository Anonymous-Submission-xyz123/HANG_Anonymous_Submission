# Copy this file to .env or export the variables in your shell.
# Never commit real credentials.

NVIDIA_API_KEY=
MINIMAX_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional OpenAI-compatible endpoint used by selected historical runners.
CUSTOM_BASE_URL=
CUSTOM_CHAT_COMPLETIONS_URL=
CUSTOM_RESPONSES_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=

# Optional provider endpoint overrides.
MINIMAX_BASE_URL=https://api.minimax.io/v1/text/chatcompletion_v2
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# White-box model configuration.
HANG_MODEL_PATH=openai/gpt-oss-20b
HANG_ATTN_IMPLEMENTATION=eager
